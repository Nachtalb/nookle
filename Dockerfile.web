# Static PWA + userscript.
FROM alpine:3.24 AS emoji
RUN apk add --no-cache curl tar
COPY scripts/fetch-emoji.sh /fetch-emoji.sh
RUN /fetch-emoji.sh /out

FROM alpine:3.24 AS web
COPY web/ /public/
COPY scripts/version-assets.sh /version-assets.sh
RUN /version-assets.sh /public

FROM ghcr.io/static-web-server/static-web-server:2
COPY --from=web /public/ /public/
COPY --from=emoji /out/emoji/ /public/emoji/
COPY userscript/nookle.user.js /public/nookle.user.js
# Telegram's emoji keywords, for finding emoji by word (sad -> 😢) in the tag autocomplete
COPY assets/emoji_keywords_en.json /public/emoji-keywords.json
COPY web.toml /web.toml
ENV SERVER_PORT=8080 SERVER_ROOT=/public SERVER_CACHE_CONTROL_HEADERS=false SERVER_CONFIG_FILE=/web.toml
